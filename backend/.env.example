# Copy to backend/.env and fill in. Never commit .env.

# Full path to the Stockfish executable (download from https://stockfishchess.org/download/)
STOCKFISH_PATH=C:/tools/stockfish/stockfish.exe
# Seconds Stockfish spends per position during game analysis
ENGINE_TIME_LIMIT=0.1
# Seconds per position for single-position requests (explain/ask)
ENGINE_DEEP_TIME_LIMIT=0.5

# Any OpenAI-compatible provider. Groq (default):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Gemini backup:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call the API (Vite dev server)
CORS_ORIGINS=http://localhost:5173
